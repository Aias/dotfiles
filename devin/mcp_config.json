{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest", "--autoConnect"]
    },
    "figma": {
      "url": "http://127.0.0.1:3845/mcp",
      "transport": "http"
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp",
      "transport": "http"
    },
    "sentry": {
      "url": "https://mcp.sentry.dev/mcp",
      "transport": "http"
    }
  }
}
